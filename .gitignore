# Claude Code runtime state (per-machine, never publish)
backups/
cache/
file-history/
ide/
logs/
plugins/
projects/
session-env/
sessions/
shell-snapshots/
tasks/
telemetry/
history.jsonl
.last-cleanup

# Real settings (only the template is in the repo)
settings.json
settings.json.*-bak
settings.json.bak.*
.claude.json
.claude.json.backup.*
.claude.json.bak.*
.claude.json.damaged-*

# cc-switch: the database holds plaintext API keys, and secrets files map
# placeholders to real keys. Only the sanitized cc-switch/*.json templates belong here.
cc-switch.db
cc-switch.db-*
*.db
*.sqlite
*.sqlite-*
secrets.json
*-secrets.json
cc-switch-secrets*.json

# Memory (user-specific learning store)
memory/

# Plans / scratch
plans/

# Setup notes (kept locally only)
SETUP_PLAN.md

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor junk
.vscode/
.idea/
*.swp
*.swo
*~

# Logs from installer test runs
install-*.log
